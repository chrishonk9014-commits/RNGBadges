{
  "name": "rng-badges",
  "version": "1.0.0",
  "private": true,
  "description": "RNG Badges \u2014 roll numbers, discover hand-designed badges, climb rarities and leaderboards.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrishonk9014-commits/RNGBadges"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "build:site": "node scripts/build-site.mjs",
    "start": "node dist/server/main.js",
    "odds": "tsx scripts/compute-odds.ts",
    "balance": "tsx scripts/balance.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
